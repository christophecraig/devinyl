{
	"$schema": "./node_modules/wrangler/config-schema.json",
	// Worker name per implementation-plan.md Phase 0.5 (S.2). Repo/package
	// name stays "blind-test"; the deployed Worker is "devinyl".
	"name": "devinyl",
	"compatibility_date": "2026-08-03",
	"compatibility_flags": [
		// Full Node.js compat shim (plan S.2), superset of "nodejs_als".
		"nodejs_compat"
	],
	// Custom entry (worker/entry.ts) wraps the adapter's generated fetch handler
	// and adds the `scheduled` export the Cron Triggers below need. See the file
	// header for why the adapter cannot do this itself.
	"main": "worker/entry.ts",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	// IP_HASH_SECRET (keys the FAIR-7 daily_guest_claim IP hash, §6) is
	// deliberately NOT declared in a `vars` block here. Precedence runs the
	// opposite way to what you might expect: `wrangler deploy` overwrites the
	// remote configuration with the local one, so a committed var CLOBBERS a
	// remote secret of the same name on every deploy — it does not lose to it.
	// A placeholder here would therefore silently key production's IP hashes
	// with a public value, making them invertible over IPv4.
	//
	// Instead:
	//   - production: `wrangler secret put IP_HASH_SECRET` (secrets survive
	//     deploys as long as no var shadows them)
	//   - local dev:  `.dev.vars` (gitignored; copy .dev.vars.example)
	// `wrangler types` reads .dev.vars, so Env.IP_HASH_SECRET stays
	// non-optional and the code can never fall back to an unkeyed digest.
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "devinyl",
			"database_id": "ac4591bc-d99a-41ba-bf27-1ce69e2b8222",
			"migrations_dir": "drizzle"
		}
	],
	// Plan deviation table: two Cron Triggers replace in-process setInterval
	// jobs, meant to dispatch through the single src/lib/server/jobs
	// runJobs(kind) entry point.
	// Dispatched by worker/entry.ts, which maps each cron expression to a
	// runJobs(kind) batch. Adding a schedule here means adding it to
	// jobKindFor() there, or the trigger fires into a logged no-op.
	"triggers": {
		"crons": [
			"*/15 * * * *",
			// Hourly batch: the ephemeral-quiz sweep (§15). Kept off the 15-min
			// tick because it is the only job here that deletes rows a player
			// could still be about to use — an unplayed generated quiz becomes a
			// leaf the moment its TTL passes, and finalize promotes it on use, so
			// the narrower the window between "TTL expired" and "swept", the more
			// the sweep depends on that promotion having already landed.
			"0 * * * *",
			// Intended as 00:05 Europe/Paris. Cron Triggers run in UTC with no
			// timezone support, and Europe/Paris is UTC+1/UTC+2 (DST) — 00:05
			// local is NOT a fixed UTC time. Using 00:05 UTC as a placeholder;
			// revisit if daily-cron timing (3.1/3.8/3.11/4.2) needs to be
			// pinned to Paris midnight rather than "some time overnight UTC".
			"5 0 * * *"
		]
	},
	"env": {
		// PR preview environment (plan S.6). `wrangler deploy --env preview`
		// deploys a SEPARATE Worker — wrangler names named environments
		// `<top-level name>-<env name>`, i.e. `devinyl-preview` — reachable at
		// https://devinyl-preview.restless-mode-79fb.workers.dev.
		//
		// All PRs share this one Worker and this one database: the preview
		// deploy is last-push-wins across concurrent PRs. That is a deliberate
		// trade for a single-developer repo (one throwaway DB to keep migrated,
		// one URL to remember) and would need per-PR envs/databases the moment
		// two PRs are ever in review at once.
		//
		// Inheritance (Wrangler config reference): `assets`, `workers_dev`,
		// `preview_urls` and `triggers` are INHERITABLE and would carry over
		// from the top level; bindings (`d1_databases`) and `vars` are NOT and
		// must be restated here. `assets` is restated anyway so this block reads
		// as the whole environment rather than a diff.
		"preview": {
			"workers_dev": true,
			"preview_urls": true,
			"assets": {
				"binding": "ASSETS",
				"directory": ".svelte-kit/cloudflare"
			},
			// Not inherited — bindings must be redefined per environment.
			// Separate throwaway database (`devinyl-preview`); production's
			// `devinyl` DB is never touched by a preview deploy.
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "devinyl-preview",
					"database_id": "7751bdbd-8e9e-47c3-ad8a-4369b96c521b",
					"migrations_dir": "drizzle"
				}
			],
			// `triggers` IS inherited, so the three production Cron Triggers
			// would otherwise also fire on the preview Worker — sweeping and
			// deleting rows in the preview DB on every 15-minute tick, and
			// doubling the account's cron invocations for no reason. Emptied
			// explicitly: preview runs no scheduled work.
			"triggers": {
				"crons": []
			},
			// DELIBERATE EXCEPTION to the no-`vars` rule above, and only here.
			// The reason that rule exists — a committed var clobbers the remote
			// secret of the same name on deploy — is precisely what makes this
			// safe: there is no real secret on the preview Worker to clobber.
			// These are the same public placeholder values .dev.vars.example
			// documents; the preview DB is throwaway, so an invertible IP hash
			// or a guessable session-signing key there costs nothing, and
			// wiring `wrangler secret put` per environment for a disposable
			// review deploy is not worth the operational surface.
			//
			// NEVER copy this block up to the top level. Production's values
			// stay in `wrangler secret` (see the long note above).
			//
			// GOOGLE_CLIENT_ID/SECRET, RESEND_API_KEY, SENTRY_DSN and
			// HEALTHCHECKS_URL are functionally unset — declared as EMPTY
			// strings, which every consumer treats as absent (Google OAuth
			// unregistered, emails logged instead of sent, errors
			// console.error'd only, no cron liveness ping; see
			// .dev.vars.example). They are declared at all because `wrangler
			// types` generates `Env` per environment: a key missing from this
			// block would go missing/optional in the generated type for the
			// whole codebase, breaking `pnpm run check` — the preview env must
			// stay type-shape-identical to production's secret set.
			"vars": {
				"IP_HASH_SECRET": "dev-placeholder-not-a-secret",
				"BETTER_AUTH_SECRET": "dev-placeholder-not-a-secret-32-bytes-min",
				"BETTER_AUTH_URL": "https://devinyl-preview.restless-mode-79fb.workers.dev",
				"GOOGLE_CLIENT_ID": "",
				"GOOGLE_CLIENT_SECRET": "",
				"RESEND_API_KEY": "",
				"SENTRY_DSN": "",
				"HEALTHCHECKS_URL": ""
			}
		}
	}
}
